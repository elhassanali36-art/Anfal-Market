{
  "expo": {
    "name": "Anfal Market (generated by app.config.js)",
    "slug": "anfal-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "anfalmarket",
    "newArchEnabled": true,
    "android": {
      "package": "com.alielhassan.anfalmarket",
      "versionCode": 1,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#16794b",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "supportsRTL": true
    },
    "plugins": [],
    "extra": {
      "apiBaseUrl": "https://YOUR-ANFAL-API-DOMAIN.example",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16794b"
    }
  }
}
